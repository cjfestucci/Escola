# Modelo do .env de produção (deploy/producao/.env). O .env de verdade fica só no servidor (chmod 600) e numa cópia no cofre de
# senhas — NUNCA no git. Gere os segredos com: openssl rand -base64 32 (JWT/Segredos) e openssl rand -hex 24 (senhas/tokens).

# Banco (só a rede interna do Docker enxerga)
DB_SENHA=

# Assina os logins. Trocar = todo mundo precisa entrar de novo.
JWT_CHAVE=
# Criptografa no banco as chaves das subcontas Asaas e os segredos de 2FA. NUNCA trocar depois de conectar escolas.
SEGREDOS_CHAVE=

# Cliente inicial (o Suporte nasce nele). Os clubes de verdade se cadastram pelo /assinar.
# Use este GUID: a migration AddClientes já cria esse cliente ("Cliente padrão") em todo banco novo; com outro GUID sobra um
# cliente vazio a mais (aconteceu no 1º deploy, 15/10/2026 — foi marcado como excluído). O CLIENTE_NOME não renomeia um
# cliente que já existe: troque o nome pela tela Plataforma.
CLIENTE_ID=00000001-0000-0000-0000-000000000001
CLIENTE_NOME=Gestor Tático — Demonstração
CLIENTE_SEGMENTO=Clube

# Conta da equipe do produto (sem os três, fica desativada). No servidor, sem a senha/segredo passarem pela tela de ninguém:
#   gt-suporte-senha   (pede a senha 2x e grava só o hash)   |   gt-suporte-totp   (gera o segredo e mostra o QR Code)
SUPORTE_EMAIL=suporte@gestortatico.com.br
SUPORTE_SENHA_HASH=
SUPORTE_TOTP_SEGREDO=

# E-mail do sistema: SMTP relay do Google Workspace (Admin → Gmail → Roteamento → SMTP relay: IP do servidor + autenticação + TLS).
# SMTP_USUARIO = conta do Workspace; SMTP_SENHA = senha de app dela (myaccount.google.com/apppasswords). Plano B: smtp-relay.brevo.com
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE_EMAIL=nao-responda@gestortatico.com.br

# Asaas (conta raiz): Sandbox até o lançamento; no lançamento, Producao + chave $aact_prod_...
ASAAS_AMBIENTE=Sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Subcontas das escolas ("Pagamento automático"): cada uma custa R$ 12,90 na criação. Ligar (true) só com o onboarding pronto.
ASAAS_SUBCONTAS=false
ASSINATURA_WEBHOOK_TOKEN=

# Exclusão automática de dados (Termos): ligar ~1 mês depois do lançamento
ASSINATURA_EXCLUSAO_AUTOMATICA=false

# Monitoramento do backup (healthchecks.io): endereço de ping do check "Backup diário". Gravar com gt-definir HC_BACKUP_URL
HC_BACKUP_URL=
