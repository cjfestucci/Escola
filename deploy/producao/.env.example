# Modelo do .env de produção (deploy/producao/.env). O .env de verdade fica só no servidor (chmod 600) e numa cópia no cofre de
# senhas — NUNCA no git. Gere os segredos com: openssl rand -base64 32 (JWT/Segredos) e openssl rand -hex 24 (senhas/tokens).

# Banco (só a rede interna do Docker enxerga)
DB_SENHA=

# Assina os logins. Trocar = todo mundo precisa entrar de novo.
JWT_CHAVE=
# Criptografa no banco as chaves das subcontas Asaas e os segredos de 2FA. NUNCA trocar depois de conectar escolas.
SEGREDOS_CHAVE=

# Cliente criado na primeira subida (o Suporte nasce nele). Os clubes de verdade se cadastram pelo /assinar.
CLIENTE_ID=
CLIENTE_NOME=Gestor Tático — Demonstração
CLIENTE_SEGMENTO=Clube

# Conta da equipe do produto (sem os três, fica desativada). Hash e segredo gerados com:
#   docker compose run --rm api --gerar-hash-senha   |   docker compose run --rm api --gerar-segredo-totp suporte@gestortatico.com.br
SUPORTE_EMAIL=suporte@gestortatico.com.br
SUPORTE_SENHA_HASH=
SUPORTE_TOTP_SEGREDO=

# E-mail do sistema (Brevo) — chave SMTP só de produção
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE_EMAIL=nao-responda@gestortatico.com.br

# Asaas (conta raiz): Sandbox até o lançamento; no lançamento, Producao + chave $aact_prod_...
ASAAS_AMBIENTE=Sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASSINATURA_WEBHOOK_TOKEN=

# Exclusão automática de dados (Termos): ligar ~1 mês depois do lançamento
ASSINATURA_EXCLUSAO_AUTOMATICA=false
