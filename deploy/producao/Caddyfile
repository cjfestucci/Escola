# HTTPS automático (Let's Encrypt): o Caddy emite e renova os certificados sozinho.
# Os registros DNS (A) precisam apontar pro servidor e ficar "DNS only" (nuvem cinza) na Cloudflare.
{
	email contato@gestortatico.com.br
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Ninguém exibe o app ou o site dentro de outra página (golpe do clique disfarçado). O frame-ancestors da CSP faz o mesmo nos navegadores novos.
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=()"
		-Server
	}
}

# CSP: só scripts do próprio domínio (nada embutido no HTML — o build do Angular está com inlineCritical desligado, e o site
# carrega tudo de arquivos .js). Estilo embutido é liberado: o Angular injeta o CSS dos componentes em <style>.
# Imagem data:/blob: = QR Code do Pix/2FA e documentos baixados; challenges.cloudflare.com = captcha (Turnstile) do /assinar. Ao incluir um recurso de fora (fonte, script, API), liberar aqui.
(csp-app) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://baas.asaas.com; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

(csp-site) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# O sistema (app Angular + API, servidos pelo nginx do contêiner "app").
app.gestortatico.com.br {
	import seguranca
	import csp-app
	# O app (login, telas internas) fica fora do Google: quem aparece nas buscas é o site (gestortatico.com.br).
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	reverse_proxy app:80
}

# Site institucional (estático, pasta site/ do repositório).
gestortatico.com.br {
	import seguranca
	import csp-site
	encode zstd gzip
	# Só a consulta de cupom vai pro app (a faixa da campanha mostra as vagas restantes); o resto da API não é exposto aqui.
	handle /api/assinaturas/cupom/* {
		reverse_proxy app:80
	}
	handle {
		root * /srv/site
		file_server
	}
}

www.gestortatico.com.br {
	redir https://gestortatico.com.br{uri} permanent
}
