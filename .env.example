# Copie para .env e preencha. NUNCA versione o .env (está no .gitignore).

# ----- Banco (compartilhado entre os clientes) -----
DB_CONNECTION=Host=meu-postgres;Port=5432;Database=escola;Username=escola_app;Password=TROQUE
# Aplica as migrations ao subir (recomendado em produção). Com vários clientes no mesmo banco, o EF usa um lock do banco.
MIGRAR_AO_INICIAR=true

# ----- Cliente inicial -----
# Um site atende todos os clientes (o login define a escola). Isto só diz qual cliente é criado na primeira subida, se ainda não existir.
# GUID: gere com `uuidgen` (Linux/Mac) ou `[guid]::NewGuid()` (PowerShell).
CLIENTE_ID=
CLIENTE_NOME=Escola de Exemplo
# Escola ou Clube — só vale na CRIAÇÃO do cliente; depois quem manda é o banco (Suporte troca na tela Plataforma).
CLIENTE_SEGMENTO=Escola
# Endereço público do site (os links de e-mail apontam pra cá), com https e sem barra no fim.
APP_URL_BASE=https://escola.exemplo.com.br
# Quantos proxies há antes da API (o seu proxy HTTPS + o nginx do site = 2). Usado pra registrar o IP real de quem aceita o termo de matrícula.
# Se não houver proxy HTTPS externo (acesso direto à porta do site), use 1.
PROXIES_NA_FRENTE=2
PORTA_SITE=8080

# ----- Segurança -----
# 32+ caracteres aleatórios (uma chave pro site todo). Trocar derruba todas as sessões abertas. Ex.: openssl rand -base64 48
JWT_CHAVE=

# ----- Conta de Suporte (equipe do produto) — deixe vazio pra não ter suporte neste ambiente -----
# Hash: dotnet run --project backend/Escola.Api -- --gerar-hash-senha     |     Segredo 2FA: ... -- --gerar-segredo-totp
SUPORTE_EMAIL=
SUPORTE_NOME=Suporte
SUPORTE_SENHA_HASH=
SUPORTE_TOTP_SEGREDO=

# ----- E-mail (convite do admin, esqueci a senha, cobrança) -----
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE_EMAIL=
SMTP_REMETENTE_NOME=Rotina Escola

# ----- Pix automático do Banco do Brasil (opcional) -----
PIX_BB_CLIENT_ID=
PIX_BB_CLIENT_SECRET=
PIX_BB_CHAVE_APLICACAO=
PIX_BB_AMBIENTE=Homologacao

# ----- Gateway Asaas (opcional) -----
# Chave da conta RAIZ da plataforma ($aact_hmlg_... no sandbox, $aact_prod_... em produção). Cada escola ganha uma subconta.
ASAAS_API_KEY=
ASAAS_AMBIENTE=Sandbox
# Token que o Asaas manda no cabeçalho asaas-access-token (invente um valor longo e aleatório)
ASAAS_WEBHOOK_TOKEN=
# Endereço público da API (o webhook é {base}/api/pagamentos/asaas/webhook). Vazio = só a conferência periódica.
ASAAS_WEBHOOK_URL_BASE=
# Cofre: 32 bytes em base64 (ex.: openssl rand -base64 32). NUNCA troque depois de conectar escolas — as chaves salvas ficam ilegíveis.
SEGREDOS_CHAVE=
